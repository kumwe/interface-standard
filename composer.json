{
  "name": "kumwe/interface-standard",
  "description": "Typed interface declarations and deterministic semantic conformance.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/interface-standard",
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "kumwe/contribution": "0.1.1",
    "kumwe/access-control": "0.1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\InterfaceStandard\\": "src/"
    }
  },
  "scripts": {
    "lint": "@php tools/lint.php",
    "test": "@php tests/run.php",
    "api": "@php tools/public-api.php",
    "api:record": "@php tools/public-api.php --write",
    "architecture": "@php tools/architecture.php",
    "examples": "@php examples/consumer.php",
    "analyse": "phpstan analyse --no-progress",
    "cs": "phpcs -q",
    "security": "composer audit --abandoned=fail",
    "clean-consumer": "@php tools/clean-consumer.php",
    "check": [
      "@composer:validate",
      "@governance",
      "@lint",
      "@api",
      "@architecture",
      "@analyse",
      "@cs",
      "@test",
      "@examples",
      "@security",
      "@clean-consumer",
      "@release:check"
    ],
    "composer:validate": "composer validate --strict",
    "release:check": [
      "bash tools/test-release-record.sh",
      "bash tools/test-release-integrity.sh",
      "bash tools/test-release-on-record.sh",
      "bash tools/test-package-dependencies.sh"
    ],
    "governance": "@php tools/verify-governed-manifests.php"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "archive": {
    "exclude": [
      "/.git",
      "/.github",
      "/vendor",
      "/composer.lock",
      "/tests",
      "/tools",
      "/phpstan.neon",
      "/phpcs.xml",
      "/.phpstan-cache"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/access-control"
    }
  ]
}
